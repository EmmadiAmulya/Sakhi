# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# server only — health check + RAG ingestion script
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# server only — NVIDIA NIM (https://build.nvidia.com)
NVIDIA_NIM_API_KEY=nvapi-...
# optional overrides
# NVIDIA_NIM_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# NEXT_PUBLIC_ENABLE_DEV_SEED=true
