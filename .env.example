# Copy to .env.local and fill in. Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# server only — health check + RAG ingestion script
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# server only — NVIDIA NIM (https://build.nvidia.com)
NVIDIA_NIM_API_KEY=nvapi-...
# optional overrides
# NVIDIA_NIM_MODEL=nvidia/nemotron-3-ultra-550b-a55b   # global override of the per-persona model
# NVIDIA_NIM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b   # retried once on NIM 5xx
# NVIDIA_NIM_REASONING_EFFORT=low   # low | high | max (NIM rejects "medium")
# NEXT_PUBLIC_ENABLE_DEV_SEED=true
